# Copy this to .env for local development
# Never commit .env to git

# Database (local dev — use docker-compose values)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=cs3portal
DB_USER=cs3user
DB_PASSWORD=cs3password
DB_SSL=false

# JWT
JWT_SECRET=change_this_to_a_long_random_string_in_production

# Server
PORT=3000
FRONTEND_URL=http://localhost:8080

GRAFANA_URL=http://grafana-internal-url:3000
PROMETHEUS_URL=http://prometheus-internal-url:9090