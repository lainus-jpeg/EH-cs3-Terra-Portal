# Copy this to terraform.tfvars
# No passwords needed — db_password is auto-generated and stored in Secrets Manager

aws_region  = "eu-central-1"
project     = "cs3"
environment = "dev"
github_repo = "lainus-jpeg/cs3-portal"

# Networking
vpc_cidr           = "10.30.0.0/16"
availability_zones = ["eu-central-1a", "eu-central-1b"]

public_subnet_cidrs     = ["10.30.0.0/24", "10.30.1.0/24"]
private_subnet_cidrs    = ["10.30.10.0/24", "10.30.11.0/24"]
db_subnet_cidrs         = ["10.30.20.0/24", "10.30.21.0/24"]
monitoring_subnet_cidrs = ["10.30.30.0/24", "10.30.31.0/24"]

# EKS — t3.medium is cheapest that supports EKS
eks_node_instance_type = "t3.medium"
eks_desired_nodes      = 2
eks_min_nodes          = 1
eks_max_nodes          = 3

# RDS
db_name     = "cs3portal"
db_username = "cs3admin"
# db_password is auto-generated — retrieve after apply:
# aws secretsmanager get-secret-value --secret-id cs3-dev-db-password
rds_multi_az = false  # set true when doing Phase 4 failover test

